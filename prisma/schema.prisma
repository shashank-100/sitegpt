// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  chatbots      Chatbot[]
  integrations  Integration[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Chatbot {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  userId                String
  model                 String   @default("gpt-4.1-mini")
  temperature           Float    @default(0.7)
  systemPrompt          String?  @db.Text
  welcomeMessage        String   @default("Hi! How can I help you today?")
  theme                 Json     @default("{\"primaryColor\":\"#0ea5e9\",\"position\":\"bottom-right\"}")
  logo                  String?
  quickPrompts          Json     @default("[]")
  collectLeads          Boolean  @default(false)
  leadFields            Json     @default("{\"email\":true,\"name\":false,\"phone\":false}")
  enableEscalation      Boolean  @default(false)
  escalationEmail       String?
  language              String   @default("en")
  enableBooking         Boolean  @default(false)
  bookingCalendarType   String?  // 'google_calendar', 'calendly', 'cal_com', 'outlook'
  bookingCalendarId     String?
  enableQualification   Boolean  @default(false)
  qualificationQuestions Json    @default("[]")
  industry              String?  // 'legal', 'healthcare', 'home_services', 'financial', 'real_estate', 'b2b'
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingData          TrainingData[]
  conversations         Conversation[]
  appointments          Appointment[]

  @@map("chatbots")
}

model TrainingData {
  id          String   @id @default(cuid())
  chatbotId   String
  type        String   // 'url', 'file', 'text'
  source      String   @db.Text
  content     String   @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbot     Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  @@map("training_data")
}

model Conversation {
  id          String    @id @default(cuid())
  chatbotId   String
  visitorId   String
  visitorName String?
  visitorEmail String?
  visitorPhone String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  chatbot     Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String       // 'user', 'assistant', 'system'
  content        String       @db.Text
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Lead {
  id                String      @id @default(cuid())
  chatbotId         String
  conversationId    String?
  name              String?
  email             String
  phone             String?
  message           String?     @db.Text
  status            String      @default("new") // 'new', 'qualified', 'contacted', 'converted', 'lost'
  score             Int         @default(0)
  qualificationData Json        @default("{}")
  source            String?     // 'chat', 'form', 'api'
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  appointment       Appointment?

  @@map("leads")
}

model Appointment {
  id              String    @id @default(cuid())
  chatbotId       String
  leadId          String    @unique
  visitorName     String
  visitorEmail    String
  visitorPhone    String?
  scheduledAt     DateTime
  duration        Int       @default(30) // minutes
  status          String    @default("scheduled") // 'scheduled', 'confirmed', 'cancelled', 'completed', 'no_show'
  meetingUrl      String?
  calendarEventId String?
  notes           String?   @db.Text
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  chatbot         Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  industry    String   // 'legal', 'healthcare', 'home_services', etc.
  description String?  @db.Text
  config      Json     @default("{}")
  prompts     Json     @default("[]")
  questions   Json     @default("[]")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}

model Integration {
  id          String   @id @default(cuid())
  userId      String
  chatbotId   String?
  type        String   // 'data_source' or 'chat_platform'
  provider    String   // 'google_drive', 'zendesk', 'slack', etc.
  name        String
  config      Json     @default("{}")
  credentials Json     @default("{}")
  status      String   @default("active") // 'active', 'inactive', 'error'
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("integrations")
}
